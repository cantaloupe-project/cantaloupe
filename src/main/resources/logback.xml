<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration>
<configuration>
  <import class="edu.illinois.library.cantaloupe.logging.AccessLogFilter" />
  <import class="net.logstash.logback.encoder.LogstashEncoder" />
  <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder" />
  <import class="edu.illinois.library.cantaloupe.logging.StandardOutputLogFilter" />
  <import class="edu.illinois.library.cantaloupe.logging.ApplicationErrorLogFilter" />
  <import class="ch.qos.logback.core.rolling.RollingFileAppender" />
  <import class="edu.illinois.library.cantaloupe.logging.ApplicationLogFilter" />
  <import class="ch.qos.logback.classic.net.SyslogAppender" />
  <import class="edu.illinois.library.cantaloupe.logging.StandardErrorLogFilter" />
  <import class="ch.qos.logback.core.FileAppender" />
  <import class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy" />
  <import class="ch.qos.logback.core.ConsoleAppender" />
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
  <appender name="AppStdoutLog" class="ConsoleAppender">
    <target>System.out</target>
    <filter class="ApplicationLogFilter" />
    <filter class="StandardOutputLogFilter" />
    <encoder class="PatternLayoutEncoder">
      <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{15}) - %msg%n</pattern>
    </encoder>
    <withJansi>false</withJansi>
  </appender>
  <appender name="AccessStdoutLog" class="ConsoleAppender">
    <filter class="AccessLogFilter" />
    <encoder class="PatternLayoutEncoder">
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>
  <appender name="AppStdoutLogLogstash" class="ConsoleAppender">
    <target>System.out</target>
    <filter class="ApplicationLogFilter" />
    <filter class="StandardOutputLogFilter" />
    <encoder class="LogstashEncoder">
      <includeContext>false</includeContext>
    </encoder>
    <withJansi>false</withJansi>
  </appender>
  <appender name="AppStderrLog" class="ConsoleAppender">
    <target>System.err</target>
    <filter class="ApplicationLogFilter" />
    <filter class="StandardErrorLogFilter" />
    <encoder class="PatternLayoutEncoder">
      <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{15}) - %msg%n</pattern>
    </encoder>
    <withJansi>false</withJansi>
  </appender>
  <appender name="AppStderrLogLogstash" class="ConsoleAppender">
    <target>System.err</target>
    <filter class="ApplicationLogFilter" />
    <filter class="StandardErrorLogFilter" />
    <encoder class="LogstashEncoder">
      <includeContext>false</includeContext>
    </encoder>
    <withJansi>false</withJansi>
  </appender>
  <if condition='property("log.application.FileAppender.enabled").contains("true")'>
    <then>
      <appender name="AppFileLog" class="FileAppender">
        <filter class="ApplicationLogFilter" />
        <file>${log.application.FileAppender.pathname}</file>
        <encoder class="PatternLayoutEncoder">
          <pattern>%date %level [%thread] %logger{10} [%file:%line] %msg%n</pattern>
        </encoder>
      </appender>
    </then>
  </if>
  <if
    condition='property("log.application.FileAppender.enabled").contains("true")  &amp;&amp; property("log.application.FileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <appender name="AppFileLogLogstash" class="FileAppender">
        <filter class="ApplicationLogFilter" />
        <file>${log.application.FileAppender.pathname}</file>
        <encoder class="LogstashEncoder">
          <includeContext>false</includeContext>
        </encoder>
      </appender>
    </then>
  </if>
  <if condition='property("log.error.FileAppender.enabled").contains("true")'>
    <then>
      <appender name="ErrorFileLog" class="FileAppender">
        <filter class="ApplicationErrorLogFilter" />
        <file>${log.error.FileAppender.pathname}</file>
        <encoder class="PatternLayoutEncoder">
          <pattern>%date %level [%thread] %logger{10} [%file:%line] %msg%n</pattern>
        </encoder>
      </appender>
    </then>
  </if>
  <if
    condition='property("log.error.FileAppender.enabled").contains("true")  &amp;&amp; property("log.error.FileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <appender name="ErrorFileLogLogstash" class="FileAppender">
        <filter class="ApplicationErrorLogFilter" />
        <file>${log.error.FileAppender.pathname}</file>
        <encoder class="LogstashEncoder">
          <includeContext>false</includeContext>
        </encoder>
      </appender>
    </then>
  </if>
  <if condition='property("log.application.RollingFileAppender.enabled").contains("true")'>
    <then>
      <appender name="AppRollingFileLog" class="RollingFileAppender">
        <filter class="ApplicationLogFilter" />
        <file>${log.application.RollingFileAppender.pathname}</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
          <fileNamePattern>${log.application.RollingFileAppender.TimeBasedRollingPolicy.filename_pattern}</fileNamePattern>
          <maxHistory>${log.application.RollingFileAppender.TimeBasedRollingPolicy.max_history}</maxHistory>
        </rollingPolicy>
        <encoder class="PatternLayoutEncoder">
          <pattern>%date %level [%thread] %logger{10} [%file:%line] %msg%n</pattern>
        </encoder>
      </appender>
    </then>
  </if>
  <if
    condition='property("log.application.RollingFileAppender.enabled").contains("true")  &amp;&amp; property("log.application.RollingFileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <appender name="AppRollingFileLogLogstash" class="RollingFileAppender">
        <filter class="ApplicationLogFilter" />
        <file>${log.application.RollingFileAppender.pathname}</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
          <fileNamePattern>${log.application.RollingFileAppender.TimeBasedRollingPolicy.filename_pattern}</fileNamePattern>
          <maxHistory>${log.application.RollingFileAppender.TimeBasedRollingPolicy.max_history}</maxHistory>
        </rollingPolicy>
        <encoder class="LogstashEncoder">
          <includeContext>false</includeContext>
        </encoder>
      </appender>
    </then>
  </if>
  <if condition='property("log.error.RollingFileAppender.enabled").contains("true")'>
    <then>
      <appender name="ErrorRollingFileLog" class="RollingFileAppender">
        <filter class="ApplicationErrorLogFilter" />
        <file>${log.error.RollingFileAppender.pathname}</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
          <fileNamePattern>${log.error.RollingFileAppender.TimeBasedRollingPolicy.filename_pattern}</fileNamePattern>
          <maxHistory>${log.error.RollingFileAppender.TimeBasedRollingPolicy.max_history}</maxHistory>
        </rollingPolicy>
        <encoder class="PatternLayoutEncoder">
          <pattern>%date %level [%thread] %logger{10} [%file:%line] %msg%n</pattern>
        </encoder>
      </appender>
    </then>
  </if>
  <if
    condition='property("log.error.RollingFileAppender.enabled").contains("true")  &amp;&amp; property("log.error.RollingFileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <appender name="ErrorRollingFileLogLogstash" class="RollingFileAppender">
        <filter class="ApplicationErrorLogFilter" />
        <file>${log.error.RollingFileAppender.pathname}</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
          <fileNamePattern>${log.error.RollingFileAppender.TimeBasedRollingPolicy.filename_pattern}</fileNamePattern>
          <maxHistory>${log.error.RollingFileAppender.TimeBasedRollingPolicy.max_history}</maxHistory>
        </rollingPolicy>
        <encoder class="LogstashEncoder">
          <includeContext>false</includeContext>
        </encoder>
      </appender>
    </then>
  </if>
  <if condition='property("log.application.SyslogAppender.enabled").contains("true")'>
    <then>
      <appender name="AppSyslogLog" class="SyslogAppender">
        <filter class="ApplicationLogFilter" />
        <syslogHost>${log.application.SyslogAppender.host}</syslogHost>
        <port>${log.application.SyslogAppender.port}</port>
        <facility>${log.application.SyslogAppender.facility}</facility>
      </appender>
    </then>
  </if>
  <if condition='property("log.access.FileAppender.enabled").contains("true")'>
    <then>
      <appender name="AccessFileLog" class="FileAppender">
        <filter class="AccessLogFilter" />
        <file>${log.access.FileAppender.pathname}</file>
        <encoder class="PatternLayoutEncoder">
          <pattern>%msg%n</pattern>
        </encoder>
      </appender>
    </then>
  </if>
  <if condition='property("log.access.RollingFileAppender.enabled").contains("true")'>
    <then>
      <appender name="AccessRollingFileLog" class="RollingFileAppender">
        <filter class="AccessLogFilter" />
        <file>${log.access.RollingFileAppender.pathname}</file>
        <rollingPolicy class="TimeBasedRollingPolicy">
          <fileNamePattern>${log.access.RollingFileAppender.TimeBasedRollingPolicy.filename_pattern}</fileNamePattern>
          <maxHistory>${log.access.RollingFileAppender.TimeBasedRollingPolicy.max_history}</maxHistory>
        </rollingPolicy>
        <encoder class="PatternLayoutEncoder">
          <pattern>%msg%n</pattern>
        </encoder>
      </appender>
    </then>
  </if>
  <if condition='property("log.access.SyslogAppender.enabled").contains("true")'>
    <then>
      <appender name="AccessSyslogLog" class="SyslogAppender">
        <filter class="AccessLogFilter" />
        <syslogHost>${log.access.SyslogAppender.host}</syslogHost>
        <port>${log.access.SyslogAppender.port}</port>
        <facility>${log.access.SyslogAppender.facility}</facility>
      </appender>
    </then>
  </if>
  <if condition='property("log.access.ConsoleAppender.enabled").contains("true")'>
    <then>
      <logger name="edu.illinois.library.cantaloupe.logging.AccessLogService" additivity="false">
        <appender-ref ref="AccessStdoutLog" />
      </logger>
    </then>
  </if>
  <if condition='property("log.access.FileAppender.enabled").contains("true")'>
    <then>
      <logger name="edu.illinois.library.cantaloupe.logging.AccessLogService" additivity="false">
        <appender-ref ref="AccessFileLog" />
      </logger>
    </then>
  </if>
  <if condition='property("log.access.RollingFileAppender.enabled").contains("true")'>
    <then>
      <logger name="edu.illinois.library.cantaloupe.logging.AccessLogService" additivity="false">
        <appender-ref ref="AccessRollingFileLog" />
      </logger>
    </then>
  </if>
  <if condition='property("log.access.SyslogAppender.enabled").contains("true")'>
    <then>
      <logger name="edu.illinois.library.cantaloupe.logging.AccessLogService" additivity="false">
        <appender-ref ref="AccessSyslogLog" />
      </logger>
    </then>
  </if>
  <root level="${log.application.level}">
  </root>
  <if condition='property("log.access.ConsoleAppender.enabled").contains("true")'>
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AccessStdoutLog" />
      </root>
    </then>
  </if>
  <if condition='property("log.access.FileAppender.enabled").contains("true")'>
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AccessFileLog" />
      </root>
    </then>
  </if>
  <if condition='property("log.access.RollingFileAppender.enabled").contains("true")'>
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AccessRollingFileLog" />
      </root>
    </then>
  </if>
  <if condition='property("log.access.SyslogAppender.enabled").contains("true")'>
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AccessSyslogLog" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.application.ConsoleAppender.enabled").contains("true")  &amp;&amp; !property("log.application.ConsoleAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppStdoutLog" />
        <appender-ref ref="AppStderrLog" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.application.ConsoleAppender.enabled").contains("true")  &amp;&amp; property("log.application.ConsoleAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppStdoutLogLogstash" />
        <appender-ref ref="AppStderrLogLogstash" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.application.FileAppender.enabled").contains("true")  &amp;&amp; !property("log.application.FileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppFileLog" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.application.FileAppender.enabled").contains("true")  &amp;&amp; property("log.application.FileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppFileLogLogstash" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.error.FileAppender.enabled").contains("true")  &amp;&amp; !property("log.error.FileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="ErrorFileLog" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.error.FileAppender.enabled").contains("true")  &amp;&amp; property("log.error.FileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="ErrorFileLogLogstash" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.application.RollingFileAppender.enabled").contains("true")  &amp;&amp; !property("log.application.RollingFileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppRollingFileLog" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.application.RollingFileAppender.enabled").contains("true")  &amp;&amp; property("log.application.RollingFileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppRollingFileLogLogstash" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.error.RollingFileAppender.enabled").contains("true")  &amp;&amp; !property("log.error.RollingFileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="ErrorRollingFileLog" />
      </root>
    </then>
  </if>
  <if
    condition='property("log.error.RollingFileAppender.enabled").contains("true")  &amp;&amp; property("log.error.RollingFileAppender.logstash.enabled").contains("true")'
  >
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="ErrorRollingFileLogLogstash" />
      </root>
    </then>
  </if>
  <if condition='property("log.application.SyslogAppender.enabled").contains("true")'>
    <then>
      <root level="${log.application.level}">
        <appender-ref ref="AppSyslogLog" />
      </root>
    </then>
  </if>
</configuration>
